<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Kanban View (default) -->
    <!-- ============================================================ -->
    <record id="icecream_flavor_view_kanban" model="ir.ui.view">
        <field name="name">icecream.flavor.kanban</field>
        <field name="model">icecream.flavor</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" default_order="sequence" sample="1">
                <field name="is_featured"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="image" widget="image"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="description" class="text-muted text-truncate"/>
                            <footer>
                                <field name="is_featured" widget="boolean_favorite"
                                       nolabel="1" class="me-2"/>
                                <span t-if="record.is_featured.raw_value"
                                      class="badge text-bg-success">
                                    <i class="fa fa-star me-1"/>Featured
                                </span>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form View -->
    <!-- ============================================================ -->
    <record id="icecream_flavor_view_form" model="ir.ui.view">
        <field name="name">icecream.flavor.form</field>
        <field name="model">icecream.flavor</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Flavor Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_featured"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Ingredients" name="description">
                            <group string="Description">
                                <field name="description" widget="html" nolabel="1"
                                       placeholder="Describe this flavor..."/>
                            </group>
                            <group string="Ingredients">
                                <field name="ingredients" widget="html" nolabel="1"
                                       placeholder="List of ingredients..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- List View -->
    <!-- ============================================================ -->
    <record id="icecream_flavor_view_list" model="ir.ui.view">
        <field name="name">icecream.flavor.list</field>
        <field name="model">icecream.flavor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="is_featured"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search View -->
    <!-- ============================================================ -->
    <record id="icecream_flavor_view_search" model="ir.ui.view">
        <field name="name">icecream.flavor.search</field>
        <field name="model">icecream.flavor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="ingredients"/>
                <filter name="featured" string="Featured"
                        domain="[('is_featured', '=', True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action -->
    <!-- ============================================================ -->
    <record id="icecream_flavor_action" model="ir.actions.act_window">
        <field name="name">Ice Cream Flavors</field>
        <field name="res_model">icecream.flavor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="icecream_flavor_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ice cream flavor!
            </p>
            <p>
                Add flavors and mark them as featured to display them on your website.
            </p>
        </field>
    </record>

</odoo>
